{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    "paths": {
      "@main/*": ["./main/*"],
      "@types": ["./types"],
      "@types/*": ["./types/*"],
      "@locales/*": ["./locales/*"],
      "@common": ["./common"],
      "@utils": ["./utils"],
      "@/*": ["./renderer/*"]
    }
  },
  "include": [
    "main/**/*",
    "common/**/*",
    "preload/**/*",
    "renderer/**/*",
    "types/**/*",
    "*.ts",
    "*.mts",
    "utils/index.ts",
    "utils/resolvePath.ts",
    "utils/stringEncrypt.ts"
  ]
}
